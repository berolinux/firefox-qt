EXPORTS.mozilla.a11y += [
    "AccessibleWrap.h",
    "QtAccessible.h",
]

SOURCES += [
    "AccessibleWrap.cpp",
    "Platform.cpp",
    "QtAccessible.cpp",
]

LOCAL_INCLUDES += [
    "/accessible/base",
    "/accessible/basetypes",
    "/accessible/generic",
    "/accessible/html",
    "/accessible/ipc",
    "/accessible/xpcom",
    "/accessible/xul",
    "/layout/generic",
    "/widget",
    "/widget/qt",
]

FINAL_LIBRARY = "xul"

CXXFLAGS += CONFIG["MOZ_QT6_CFLAGS"]
OS_LIBS += CONFIG["MOZ_QT6_LIBS"]

# Qt headers conflict with -fvisibility=hidden wrappers.
NoVisibilityFlags()

include("/ipc/chromium/chromium-config.mozbuild")
