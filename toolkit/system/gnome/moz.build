# file, You can obtain one at http://mozilla.org/MPL/2.0/.

with Files("**"):
    BUG_COMPONENT = ("Firefox", "Shell Integration")
    SCHEDULES.exclusive = ["linux"]

SOURCES += [
    "nsGIOService.cpp",
]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    SOURCES += [
        "nsAlertsIconListener.cpp",
        "nsSystemAlertsService.cpp",
    ]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    XPCOM_MANIFESTS += [
        "components.conf",
    ]
else:
    # Qt: GIO service only.
    XPCOM_MANIFESTS += [
        "components.gio.conf",
    ]

FINAL_LIBRARY = "xul"

LOCAL_INCLUDES += [
    "/toolkit/components/build/",
]

CXXFLAGS += CONFIG["GLIB_CFLAGS"]
# gdesktopappinfo lives in gio-unix.
CXXFLAGS += ["-I/usr/include/gio-unix-2.0"]
if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    CXXFLAGS += CONFIG["MOZ_GTK3_CFLAGS"]

SOURCE_HEADERS += [
    "nsAlertsIconListener.h",
    "nsGIOService.h",
    "nsSystemAlertsService.h",
]
