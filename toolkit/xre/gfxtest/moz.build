with Files("**"):
    BUG_COMPONENT = ("Core", "Widget: Gtk")

Program("gfxtest")
SOURCES += [
    "gfxtest.cpp",
]

# glxtest and the GTK/X11 libraries are the GLX probe. Qt only needs the
# VA-API (and Vulkan) subcommands, which dlopen libva and libvulkan.
if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    SOURCES += ["glxtest.cpp"]
    CXXFLAGS += CONFIG["MOZ_GTK3_CFLAGS"]
    CXXFLAGS += CONFIG["MOZ_PANGO_CFLAGS"]
    OS_LIBS += CONFIG["MOZ_X11_LIBS"]
    OS_LIBS += CONFIG["MOZ_GTK3_LIBS"]

if CONFIG["MOZ_ENABLE_VAAPI"]:
    SOURCES += ["vaapitest.cpp"]
    USE_LIBS += ["mozva"]
    LOCAL_INCLUDES += ["/media/mozva"]

if CONFIG["MOZ_ENABLE_V4L2"]:
    SOURCES += ["v4l2test.cpp"]

if CONFIG["MOZ_ENABLE_VULKAN_VIDEO"]:
    SOURCES += ["vulkantest.cpp"]
    LOCAL_INCLUDES += ["/third_party/khronos/vulkan-headers/include"]

OS_LIBS += CONFIG["DL_LIBS"]

if CONFIG["MOZ_ASAN"] or CONFIG["MOZ_UBSAN"] or CONFIG["MOZ_TSAN"]:
    USE_LIBS += ["sanitizer-options"]

NO_PGO = True
DisableStlWrapping()
